---
import site from '../data/site.json';
import board from '../data/board.json';
const B: any = board;
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    {B.id ? <div>{B.spec} <a href={B.id === 'language' ? '/literature/' : '/language/'}>Studying {B.id === 'language' ? 'Literature' : 'Language'}? Switch subject</a></div> : <div>AQA A-level English Language (7702, AS 7701) and AQA A-level English Literature A (7712, AS 7711).</div>}
    <div>Past-paper questions, mark schemes and examiner reports are © {B.id ? B.holder : 'AQA'} and are shown free for study. This site is not affiliated with {B.id ? B.holder : 'AQA'}. <a href="/about/">About this site</a></div>
    <div><a href="/privacy/">Privacy</a> · <a href="/terms/">Terms</a> · <a href="/report/">Report a mistake</a></div>
    <div>© {year} {site.company} · Company no. {site.companyNumber}, registered in England and Wales · <a href={`mailto:${site.email}`}>{site.email}</a></div>
  </div>
</footer>
