---
import Base from '../layouts/Base.astro';
import { allTopics, allQuestions, allPapers, groupInfo, B, GROUPS } from '../lib/data';
import tutors from '../data/tutors.json';
import Icon from '../components/Icon.astro';
// The root page (shared build) asks which subject; each subject build renders its own home page at /language/ or /literature/.
const top = (B.homeTop || []).map((s: string) => allTopics.find((t) => t.slug === s)).filter(Boolean);
const topics = allTopics.map((t) => ({ slug: t.slug, name: t.name, parts: t.parts }));
const essays = allQuestions.filter((q) => (B.essayMarks || []).includes(q.marks)).length;
const latest = allPapers.filter((p) => p.kind === 'exam').sort((a, b) => b.year - a.year)[0]?.series;
const first = allPapers.filter((p) => p.kind === 'exam').sort((a, b) => a.year - b.year)[0]?.series;
---
{!B.id ? (
<Base title="AQA A-level English Language and Literature past papers by question, with online tutors" description="Free AQA A-level English Language and English Literature A past-paper questions sorted by topic and set text, with inserts, mark schemes, examiner comments, practice, mocks and specialist online English tutors." context="home" leadLine="Not sure where to start? Tell us the year group, the subject and the target grade and we will arrange a trial lesson.">
  <h1>AQA A-level English, one question at a time</h1>
  <p>Every AQA A-level and AS English Language and English Literature A past paper since 2016, cut into questions and sorted by topic and set text, with the texts and extracts, the mark scheme and the examiner's comment one tap away. Free, no sign-up. Which subject do you take?</p>
  <div class="tiles board-pick">
    <a class="tile-card" href="/language/"><Icon name="book" /><strong>English Language</strong><span>AQA A level 7702 and AS 7701: textual variations and representations, child language acquisition, language diversity and change, discourses, opinion-article writing</span></a>
    <a class="tile-card" href="/literature/"><Icon name="book" /><strong>English Literature A</strong><span>AQA A level 7712 and AS 7711: Love through the ages (Shakespeare, the poetry anthology, prose, unseen poetry), WW1 and its aftermath, Modern times</span></a>
  </div>
  <p class="muted">Check your board: it is on the front of your past papers and your school's exam timetable. AQA English Language papers are coded 7702 (AS 7701) and AQA English Literature A papers 7712 (AS 7711). English Literature B (7717) is a different specification.</p>
  <h2>Specialist English tutors</h2>
  <p>Online one-to-one lessons with <a href="/tutors/">Isobel</a>, who currently teaches A-level English as Head of English Language and Literature at a top sixth-form college and is an AQA examiner. She knows what the examiners reward: precise analysis with the right terminology, a sustained argument, and context and other readings woven in rather than bolted on.</p>
  <div class="btn-row"><a class="btn" href="/tutors/"><Icon name="users" />Meet the tutors</a></div>
</Base>
) : (
<Base title={`${B.full}: past-paper questions by topic, mark schemes and tutors`} context="home" leadLine={`Not sure where to start? Tell us the year group and target grade and we will arrange a trial lesson with a specialist ${B.short} ${B.subj} tutor.`}>
  <h1>{B.full}, one topic at a time</h1>
  <p>{`${allQuestions.length.toLocaleString()} questions from ${allPapers.length} ${B.short} ${B.subj} papers (${B.codes}) from ${first} to ${latest}`}, sorted by topic, with the {B.id === 'literature' ? 'extracts and unseen texts' : 'texts from the insert'}, the mark scheme and the examiner's comment one tap away. Free, no sign-up.</p>
  <p class="muted">{B.latestNote}{" "}<a href={B.id === 'language' ? '/literature/' : '/language/'}>Studying {B.id === 'language' ? 'Literature' : 'Language'} instead?</a></p>

  <div class="progress-box" id="progress" hidden>
    <strong>Your progress</strong>
    <dl><div><dt>Checklist ticks</dt><dd id="pr-ticks">0</dd></div><div><dt>Questions marked</dt><dd id="pr-q">0</dd></div><div><dt>Weakest topic</dt><dd id="pr-weak">—</dd></div></dl>
    <a href="/planner/">Build a plan from these</a> · <a href="/specification/">Checklist</a>
  </div>

  <nav class="tool-strip" aria-label="Key tools">
    <a href="/practice/"><Icon name="target" />Practice</a>
    <a href="/past-papers/"><Icon name="file" />Past papers</a>
    <a href="/essays/"><Icon name="pen" />Essays</a>
    <a href={`/questions/type/${B.homeTiles[0][0]}/`}><Icon name="chart" />{B.homeTiles[0][4]}</a>
    <a href="/mock/"><Icon name="timer" />Mock</a>
  </nav>

  <label for="topic-search" class="muted">Find a topic</label>
  <input id="topic-search" class="search" type="search" placeholder={B.searchHint} autocomplete="off" />

  <h2 class="strand-head">Most-examined topics</h2>
  <ul class="topic-list" id="topic-list">
    {top.map((t) => <li><a href={`/questions/${t.slug}/`}><span>{t.name}</span><span class="strand"><span class={`badge badge-${groupInfo(t.group).badge}`}>{groupInfo(t.group).short}</span> {t.parts} questions</span></a></li>)}
  </ul>
  <p><a href="/questions/">{`All ${allTopics.length} ${B.id === 'literature' ? 'set texts and question types' : 'topics'} in ${GROUPS.length} sections`}</a></p>

  <h2>Everything on the site</h2>
  <div class="tiles">
    <a class="tile-card" href="/past-papers/"><Icon name="file" /><strong>Past papers</strong><span>Every {B.alCode} and {B.asCode} paper since {first} with a question-by-question table</span></a>
    <a class="tile-card" href="/practice/"><Icon name="target" /><strong>Practice</strong><span>Real questions one at a time, self-marked against the mark scheme and its levels</span></a>
    <a class="tile-card" href="/essays/"><Icon name="pen" /><strong>Essays</strong><span>All {essays} essay titles ever set ({B.essayMarks.join(', ')} marks), by topic, and a timed essay tool</span></a>
    {(B.homeTiles || []).map((t: any) => <a class="tile-card" href={`/questions/type/${t[0]}/`}><Icon name={t[3]} /><strong>{t[1]}</strong><span>{t[2]}</span></a>)}
    <a class="tile-card" href="/mock/"><Icon name="timer" /><strong>Mock builder</strong><span>A timed paper in the real shape, from real questions, with your options</span></a>
    <a class="tile-card" href="/specification/"><Icon name="checklist" /><strong>Spec checklist</strong><span>Every {B.id === 'literature' ? 'set text and area of study' : 'content point'} of the specification, tickable, linked to its questions</span></a>
    <a class="tile-card" href="/analysis/"><Icon name="chart" /><strong>What comes up</strong><span>Marks by topic each year, the latest papers, every paper as a timeline</span></a>
    <a class="tile-card" href="/grade-boundaries/"><Icon name="calendar" /><strong>Boundaries and dates</strong><span>Grade calculator and the 2027 exam dates with a countdown</span></a>
    <a class="tile-card" href="/planner/"><Icon name="lightbulb" /><strong>Revision planner</strong><span>A week-by-week plan to Paper 1 from your weak areas</span></a>
    <a class="tile-card" href="/tutors/"><Icon name="users" /><strong>Tutors</strong><span>Online one-to-one {B.short} {B.subj} lessons with experienced A-level English teachers</span></a>
  </div>

  <script define:vars={{ topics, store: B.store }}>
    try {
      const ticks = JSON.parse(localStorage.getItem(store + '-spec') || '{}'), scores = JSON.parse(localStorage.getItem(store + '-scores') || '{}');
      const nTicks = Object.values(ticks).filter(Boolean).length, rows = Object.entries(scores);
      const nQ = rows.reduce((n, [, r]) => n + (r.n || 0), 0);
      if (nTicks || nQ) {
        document.getElementById('progress').hidden = false;
        document.getElementById('pr-ticks').textContent = nTicks;
        document.getElementById('pr-q').textContent = nQ;
        const weak = rows.filter(([, r]) => r.total).sort((a, b) => a[1].earned / a[1].total - b[1].earned / b[1].total)[0];
        if (weak) { const t = topics.find((x) => x.slug === weak[0]); document.getElementById('pr-weak').innerHTML = t ? `<a href="/questions/${t.slug}/">${t.name}</a> ${Math.round(100 * weak[1].earned / weak[1].total)}%` : '—'; }
      }
    } catch {}
    const input = document.getElementById('topic-search');
    const list = document.getElementById('topic-list');
    const initial = list.innerHTML;
    input.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      if (!q) { list.innerHTML = initial; return; }
      const items = topics.filter((t) => t.name.toLowerCase().includes(q) || t.slug.includes(q.replace(/\s+/g, '-')));
      list.innerHTML = items.length
        ? items.map((t) => `<li><a href="/questions/${t.slug}/"><span>${t.name}</span><span class="strand">${t.parts} questions</span></a></li>`).join('')
        : '<li class="muted">No topic matches that. <a href="/questions/">Browse all topics</a>.</li>';
    });
  </script>
</Base>
)}
